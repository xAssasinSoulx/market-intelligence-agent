@startuml
title Stage 2 - Authentication and persistence

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

note as Scope
  SQLite file data/market-intelligence.db.
  Tables: users, portfolio_positions, watchlist_items, conversation_turns.
  Preferences and conversation sessions from Stage 1 were not implemented.
  Stage 1 renders stay in docs/Stage1-pdfs.
end note

package "Authentication" {
    class AuthService {
        + register(username, password): User
        + authenticate(username, password): User
    }
    class SessionManager {
        + startSession(user): UserSession
        + endSession(): void
        + isAuthenticated(): boolean
        + getCurrentUserId(): long
    }
    class UserSession
    interface PasswordHasher {
        + hash(password): String
        + verify(password, hash): boolean
    }
    class BCryptPasswordHasher
}

package "Repositories" {
    interface UserRepository {
        + save(user): User
        + findById(userId): Optional
        + findByUsername(username): Optional
        + existsByUsername(username): boolean
    }
    interface PortfolioRepository {
        + loadForUser(userId): Portfolio
        + saveForUser(userId, portfolio): void
    }
    interface WatchlistRepository {
        + loadForUser(userId): Watchlist
        + saveForUser(userId, watchlist): void
    }
    interface ConversationRepository {
        + append(turn): void
        + recent(userId, limit): List
    }
    class DatabaseManager {
        + initialize(): void
        + getConnection(): Connection
    }
    class SQLiteUserRepository
    class SQLitePortfolioRepository
    class SQLiteWatchlistRepository
    class SQLiteConversationRepository
}

PasswordHasher <|.. BCryptPasswordHasher
AuthService --> PasswordHasher
AuthService --> UserRepository
SessionManager --> UserSession

UserRepository <|.. SQLiteUserRepository
PortfolioRepository <|.. SQLitePortfolioRepository
WatchlistRepository <|.. SQLiteWatchlistRepository
ConversationRepository <|.. SQLiteConversationRepository

SQLiteUserRepository --> DatabaseManager
SQLitePortfolioRepository --> DatabaseManager
SQLiteWatchlistRepository --> DatabaseManager
SQLiteConversationRepository --> DatabaseManager

SQLiteConversationRepository --> ConversationTurn

note bottom of SQLiteConversationRepository
  conversation_turns.user_id references users(id)
  on delete cascade. Bodies are capped.
  Turns are loaded only for the signed-in user.
end note

@enduml
