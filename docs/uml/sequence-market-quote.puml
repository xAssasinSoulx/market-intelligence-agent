@startuml
title UC-04 - Get a market quote

autonumber

actor User
participant "TerminalUI or\nMarketIntelFrame" as UI
participant ResearchGateway <<facade>>
participant SessionManager
participant ToolManager
participant MarketDataTool
participant RequestValidator
participant ProviderRouter
participant FinnhubAdapter

User -> UI : QUOTE NVDA
UI -> ResearchGateway : execute(userId, MARKET_QUOTE, NVDA)
ResearchGateway -> SessionManager : isAuthenticated()
SessionManager --> ResearchGateway : true
ResearchGateway -> ToolManager : execute(ToolRequest)
ToolManager -> MarketDataTool : execute(request)
MarketDataTool -> RequestValidator : validateSymbol(NVDA)

alt Symbol is valid
    MarketDataTool -> ProviderRouter : getQuote(NVDA)
    ProviderRouter -> FinnhubAdapter : getQuote(NVDA)
    alt Quote succeeds
        FinnhubAdapter --> ProviderRouter : MarketQuote
        ProviderRouter --> MarketDataTool : MarketQuote
        MarketDataTool --> ToolManager : ToolResult(success)
    else Provider fails
        FinnhubAdapter --> MarketDataTool : MarketDataException
        MarketDataTool --> ToolManager : ToolResult(failure)
    end
else Symbol is invalid
    MarketDataTool --> ToolManager : ToolResult(failure)
end

ToolManager --> ResearchGateway : ToolResult
opt Success
    ResearchGateway -> AgentController : noteLookup(userId, NVDA, MARKET_QUOTE)
end
ResearchGateway --> UI : ToolResult
UI --> User : price, previous close, percent change

note right of ProviderRouter
  First registered quote adapter wins.
  Twelve Data, then Alpha Vantage,
  are used only if Finnhub was not registered.
  A failed call does not try the next adapter.
  This path does not call Gemini.
end note

@enduml
