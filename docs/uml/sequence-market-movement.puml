@startuml
title UC-10 - Explain a recent move

autonumber

actor User
participant "UI or AgentController" as Entry
participant ResearchGateway
participant MarketMovementTool
participant ProviderRouter
participant MarketExplanationService
participant GeminiLLMClient

User -> Entry : WHY MSFT
alt Direct command
    Entry -> ResearchGateway : explainMovement(userId, MSFT)
    ResearchGateway -> MarketMovementTool : execute(MARKET_MOVEMENT)
else Follow-up sentence
    Entry -> MarketMovementTool : execute(MARKET_MOVEMENT)
end

MarketMovementTool -> ProviderRouter : getQuote(MSFT)
ProviderRouter --> MarketMovementTool : MarketQuote
MarketMovementTool -> ProviderRouter : getNews(MSFT)
ProviderRouter --> MarketMovementTool : articles
MarketMovementTool --> Entry : MarketMovementContext

alt Gemini is configured and evidence exists
    Entry -> MarketExplanationService : explain(context)
    MarketExplanationService -> GeminiLLMClient : generateBrief(prompt)
    GeminiLLMClient --> Entry : short note grounded in the quote and news
else Gemini is missing or the call fails
    Entry --> User : quote and news, plus the failure note
end

note right of MarketExplanationService
  The prompt contains the quote and up to
  three article summaries. It does not ask
  for a buy or sell recommendation.
  Articles after the last trade are flagged
  before they reach this prompt.
end note

@enduml
