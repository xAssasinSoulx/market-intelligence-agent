@startuml
title Stage 2 - Domain model

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

note as Scope
  Types that exist in src/main/java.
  Stage 1 renders stay in docs/Stage1-pdfs.
  There is no AgentRequest, PlanStep, UserPreferences,
  or ConversationSession class.
end note

package "Agent" {
    class AgentPlan {
        + kind: Kind
        + action: ActionType
        + symbol: String
        + secondSymbol: String
        + message: String
    }
    enum "AgentPlan.Kind" as Kind {
        RUN
        CLARIFY
        UNSUPPORTED
    }
    class ToolRequest {
        + userId: long
        + action: ActionType
        + arguments: Map
    }
    class ToolResult {
        + success: boolean
        + data: Object
        + errorMessage: String
    }
    enum ActionType {
        MARKET_QUOTE
        SECURITY_OVERVIEW
        ETF_SECTOR_EXPOSURE
        ETF_GEOGRAPHIC_EXPOSURE
        SECURITY_COMPARISON
        ETF_OVERLAP
        FINANCIAL_NEWS
        MARKET_MOVEMENT
        PORTFOLIO_VIEW
        PORTFOLIO_ADD
        PORTFOLIO_REMOVE
        PORTFOLIO_EXPOSURE
        WATCHLIST_VIEW
        WATCHLIST_ADD
        WATCHLIST_REMOVE
        FINANCIAL_STATEMENTS
        PRICE_HISTORY
        NEWS_SENTIMENT
    }
}

package "Market" {
    class MarketQuote
    class SecurityOverview
    class ETFProfile
    class ETFHolding
    class ExposureResult
    class OverlapResult
    class NewsArticle
    class FinancialStatements
    class PriceHistory
    class SentimentReading
    class MarketMovementContext
}

package "Portfolio" {
    class Portfolio
    class PortfolioPosition
    class PortfolioExposureResult
    class Watchlist
    enum AssetType {
        STOCK
        ETF
        OTHER
    }
}

package "Account and memory" {
    class User
    class UserSession
    class ConversationTurn {
        + userId: long
        + role: String
        + body: String
        + symbol: String
        + action: String
    }
}

AgentPlan --> Kind
AgentPlan --> ActionType
ToolRequest --> ActionType
Portfolio "1" *-- "0..*" PortfolioPosition
PortfolioPosition --> AssetType
ETFProfile o-- "0..*" ETFHolding
MarketMovementContext --> MarketQuote
MarketMovementContext o-- "0..*" NewsArticle

@enduml
