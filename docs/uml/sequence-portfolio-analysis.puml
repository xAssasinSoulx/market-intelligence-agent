@startuml
title UC-15 - Portfolio exposure

autonumber

actor User
participant "TerminalUI or\nMarketIntelFrame" as UI
participant ResearchGateway
participant PortfolioAnalysisTool
participant PortfolioService
participant ProviderRouter
participant PortfolioExposureCalculator

User -> UI : EXPOSURE
UI -> ResearchGateway : execute(userId, PORTFOLIO_EXPOSURE)
ResearchGateway -> PortfolioAnalysisTool : execute(request)
PortfolioAnalysisTool -> PortfolioService : getPortfolio(userId)
PortfolioService --> PortfolioAnalysisTool : positions

loop Each position
    PortfolioAnalysisTool -> ProviderRouter : getQuote(symbol)
    alt Quote succeeds
        ProviderRouter --> PortfolioAnalysisTool : price
    else No price
        ProviderRouter --> PortfolioAnalysisTool : error, position is named and excluded
    end
    opt Position is an ETF and holdings are available
        PortfolioAnalysisTool -> ProviderRouter : getProfile(symbol)
        ProviderRouter --> PortfolioAnalysisTool : sector weights and holdings
    end
end

PortfolioAnalysisTool -> PortfolioExposureCalculator : calculate(inputs)
PortfolioExposureCalculator --> UI : value = price x quantity, by currency

note right of PortfolioExposureCalculator
  Day move uses price minus previous close, times quantity.
  Currencies stay in separate books.
  A follow-up that reaches this action does not send
  the numbers to Gemini. The formatted report is the reply.
end note

@enduml
