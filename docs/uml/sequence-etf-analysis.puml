@startuml
title UC-06 - Sector exposure

autonumber

actor User
participant "TerminalUI or\nMarketIntelFrame" as UI
participant ResearchGateway
participant ToolManager
participant ETFExposureTool
participant RequestValidator
participant ProviderRouter
participant AlphaVantageAdapter
participant ExposureCalculator

User -> UI : SECTOR QQQ
UI -> ResearchGateway : execute(userId, ETF_SECTOR_EXPOSURE, QQQ)
ResearchGateway -> ToolManager : execute(ToolRequest)
ToolManager -> ETFExposureTool : execute(request)
ETFExposureTool -> RequestValidator : validateSymbol(QQQ)

alt Symbol is valid and holdings are available
    ETFExposureTool -> ProviderRouter : getProfile(QQQ)
    ProviderRouter -> AlphaVantageAdapter : getEtfProfile(QQQ)
    AlphaVantageAdapter --> ETFExposureTool : ETFProfile
    ETFExposureTool -> ExposureCalculator : calculateSectorExposure(profile)
    ExposureCalculator --> ETFExposureTool : ExposureResult
    ETFExposureTool --> ToolManager : ToolResult(success)
else Holdings or the symbol fail
    ETFExposureTool --> ToolManager : ToolResult(failure)
end

ToolManager --> ResearchGateway : ToolResult
ResearchGateway --> UI : ToolResult
UI --> User : sector weights

note right of ETFExposureTool
  Deterministic. Gemini is not called.
  Country weights use sequence-country-exposure.
end note

@enduml
