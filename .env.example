# Copy this file to .env and fill in your own keys.
# Do not commit .env. The application reads environment variables,
# not this file. Export them in your shell before launching.

ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key
MARKETAUX_API_TOKEN=your-marketaux-token
GEMINI_API_KEY=your-gemini-key

# Optional. Annual statements. About 250 calls a day; /statements uses three.
# Confirm the limit when you sign up.
# FMP_API_KEY=your-fmp-key

# Optional. Daily prices, RSI, and a quote fallback.
# About 800 calls a day and 8 a minute. Confirm when you sign up.
# TWELVE_DATA_API_KEY=your-twelve-data-key

# Optional. One sentiment score per symbol.
# About 1,000 requests a month. Confirm when you sign up.
# SENTISENSE_API_KEY=your-sentisense-key

# Optional. Omit to use the client's default Gemini model.
# GEMINI_MODEL=gemini-2.0-flash

# Optional. Set to 1 to keep terminal scrollback instead of
# clearing the screen on each view.
# MI_SCROLLBACK=1
